# =============================================================================
# Capacity Connect — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file with secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Django Settings
# -----------------------------------------------------------------------------
SECRET_KEY=your-secure-production-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_NAME=capacity_connect
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Supabase Authentication & Object Storage
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard
# Persistent media storage (assignment submissions & documents):
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend code!
SUPABASE_STORAGE_BUCKET=capacity-media
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-from-dashboard
DEFAULT_FILE_STORAGE_BACKEND=filesystem  # Options: 'filesystem' (local dev), 'supabase' (cloud production)


# -----------------------------------------------------------------------------
# CORS & CSRF Settings
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://app.yourdomain.com

# -----------------------------------------------------------------------------
# Security & SSL Configuration (when DEBUG=False)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# -----------------------------------------------------------------------------
# DRF API Throttling Rates
# -----------------------------------------------------------------------------
DRF_THROTTLE_ANON=100/minute
DRF_THROTTLE_USER=500/minute
DRF_THROTTLE_AUTH=15/minute
DRF_THROTTLE_VERIFY=60/minute

# -----------------------------------------------------------------------------
# Email Configuration (Production SMTP)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=Capacity Connect <noreply@yourdomain.com>
